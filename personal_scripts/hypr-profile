#!/bin/sh

profile="${1:-}"
profile_dir="$HOME/.config/hypr/profiles"

case "$profile" in
    normal|coding)
        profile_file="$profile_dir/$profile.conf"
        ;;
    *)
        printf 'Usage: %s {normal|coding}\n' "$0" >&2
        exit 2
        ;;
esac

if ! command -v hyprctl >/dev/null 2>&1; then
    printf 'hyprctl was not found\n' >&2
    exit 1
fi

hyprctl keyword source "$profile_file" >/dev/null

case "$profile" in
    normal) kitty_opacity=0.80 ;;
    coding) kitty_opacity=1.00 ;;
esac

hyprctl clients -j | jq -r '.[] | select(.class == "kitty") | .address' |
    while IFS= read -r address; do
        [ -n "$address" ] && hyprctl setprop address:"$address" opacity "$kitty_opacity" lock >/dev/null
    done

case "$profile" in
    normal) notify_color="rgb(89b4fa)" ;;
    coding) notify_color="rgb(a6e3a1)" ;;
esac

hyprctl notify 5 2000 "$notify_color" "  $profile" >/dev/null