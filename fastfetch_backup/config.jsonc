{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "\"$(fastfetch.sh logo)\"",
    "height": 12,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " 󰄾 "
  },
  "modules": [
    {
      "type": "title",
      "key": "   ",
      "keyColor": "red",
      "format": "{1}@{2}"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "  󰣇 OS     ",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "   Kernel ",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "  󰏗 Pkgs   ",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "   Term   ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM     ",
      "format": "{2}",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "   CPU    ",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  󰊴 GPU    ",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "   RAM    ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "square"
    }
  ]
}
