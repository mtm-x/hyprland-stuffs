{
    "layer": "top",
    "position": "top",
    "output": ["*"],
    "height": 30,
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,

    "modules-left": [
        "wlr/taskbar",
        "mpris"
    ],

    "modules-center": [
        "idle_inhibitor",
        "clock"
    ],

    "modules-right": [
        "battery",
        "tray"
    ],

    "wlr/taskbar": {
        "all-outputs": true,
        "active-first": false,
        "format": "{icon}",
        "icon-size": 16,
        "spacing": 4,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-right": "fullscreen",
        "on-click-middle": "close",
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        }
    },

    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "format-stopped": "",
        "player-icons": {
            "default": "",
            "mpv": "",
            "spotify": "",
            "firefox": "󰈹",
            "chromium": "",
            "zen": "󰈹"
        },
        "status-icons": {
            "paused": "󰏤",
            "playing": "󰐊",
            "stopped": "󰓛"
        },
        "dynamic-order": ["title", "artist"],
        "dynamic-importance-order": ["title", "artist"],
        "dynamic-len": 28,
        "max-length": 32,
        "tooltip-format": "{player} ({status})\n{title} - {artist}\n\n󰐊 Left-click: Play/Pause\n󰒭 Right-click: Next track\n󰒮 Middle-click: Previous track"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Idle Inhibitor: Active (screen won't sleep)",
        "tooltip-format-deactivated": "Idle Inhibitor: Inactive"
    },

    "clock": {
        "interval": 1,
        "format": "  {:%H:%M}",
        "format-alt": "󰸗  {:%a, %d %b %Y (%H:%M:%S)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#d9d9d9'><b>{}</b></span>",
                "days": "<span color='#a6a6a6'><b>{}</b></span>",
                "weeks": "<span color='#595959'><b>W{}</b></span>",
                "weekdays": "<span color='#8c8c8c'><b>{}</b></span>",
                "today": "<span color='#ffffff' background='#404040'><b><u>{}</u></b></span>"
            }
        }
    },

    "battery": {
        "interval": 10,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\nPower draw: {power}W"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    }
}