: 1784868344:0;identify muzandemonslayer.png
: 1784868610:0;c
: 1784868613:0;# 1. Resize to match your combined screen width (5760px), keeping aspect ratio\
convert muzandemonslayer.png -resize 5760x muzandemonslayer_resized.png\
\
# 2. Crop each monitor's slice (top-aligned, matching your hyprctl offsets)\
convert muzandemonslayer_resized.png -crop 1920x1080+0+0    +repage dp1.png      # DP-1\
convert muzandemonslayer_resized.png -crop 1920x1080+1920+0 +repage hdmi1.png    # HDMI-A-1\
convert muzandemonslayer_resized.png -crop 1920x1200+3840+0 +repage edp1.png     # eDP-1 (taller)\
\
# 3. Apply to each monitor\
swww img dp1.png -o DP-1\
swww img hdmi1.png -o HDMI-A-1\
swww img edp1.png -o eDP-1
: 1784868966:0;c
: 1784869181:0;# 1. Scale to cover the 3840x1080 combined canvas, then center-crop to exact size (no stretching)\
magick muzandemonslayer.png -resize 3840x1080^ -gravity center -extent 3840x1080 dual_combined.png\
\
# 2. Split into the two monitor halves\
magick dual_combined.png -crop 1920x1080+0+0    +repage dp1.png     # DP-1 (left)\
magick dual_combined.png -crop 1920x1080+1920+0 +repage hdmi1.png  # HDMI-A-1 (right)\
\
# 3. Apply â€ƒ´ only these two, laptop untouched\
swww img dp1.png -o DP-1\
swww img hdmi1.png -o HDMI-A-1
