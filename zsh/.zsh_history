: 1774856531:0;# 1. Create the cache directory just in case it's missing\
mkdir -p ~/.cache/awww\
# 2. Symlink the new 'awww' binaries so HyDE scripts can find them\
sudo ln -sf /usr/bin/awww /usr/bin/swww\
sudo ln -sf /usr/bin/awww-daemon /usr/bin/swww-daemon\
# 3. Kill any stuck daemons\
pkill awww-daemon\
pkill swww-daemon\
# 4. Restart the daemon with your Wayland display namespace\
swww-daemon --namespace "$WAYLAND_DISPLAY" &\
# 5. Reload the HyDE shell to apply\
hyde-shell reload
