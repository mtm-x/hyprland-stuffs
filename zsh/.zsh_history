: 1775152636:0;for file in $(find Documentation/devicetree/bindings/ -name "*.txt" -type f -exec wc -l {} + | awk '$1 >= 15 && $1 <= 50' | awk '{print $2}'); do\
    # Extract strings that look like "vendor,device" from lines containing "compatible"\
    grep -i "compatible" "$file" | grep -oE '[a-zA-Z0-9\-]+,[a-zA-Z0-9\-]+' | sort -u | while read comp; do\
        # Check if that string exists in the ARM or ARM64 device trees\
        if git grep -ql "$comp" arch/arm64/boot/dts/ arch/arm/boot/dts/; then\
            echo "
: 1781498556:0; BINGO: $file uses '$comp'"\
        fi\
    done\
done
: 1775152689:0;for file in $(find Documentation/devicetree/bindings/ -name "*.txt" -type f -exec wc -l {} + | awk '$1 >= 15 && $1 <= 50' | awk '{print $2}'); do\
    # Extract strings that look like "vendor,device" from lines containing "compatible"\
    grep -i "compatible" "$file" | grep -oE '[a-zA-Z0-9\-]+,[a-zA-Z0-9\-]+' | sort -u | while read comp; do\
        # Check if that string exists STRICTLY in the ARM64 device trees\
        if git grep -ql "$comp" arch/arm64/boot/dts/; then\
            echo "
: 1781498556:0; BINGO (ARM64): $file uses '$comp'"\
        fi\
    done\
done
